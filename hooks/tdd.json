{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python .github/tddctl.py begin",
        "timeout": 30
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "python .github/tddctl.py subagent",
        "timeout": 60
      }
    ]
  }
}